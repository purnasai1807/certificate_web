# Production configuration (set real values in Vercel, never commit secrets)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-in-production
ADMIN_FULL_NAME=Certificate Administrator
JWT_SECRET=generate-a-long-random-secret
REQUIRE_PERSISTENT_STORAGE=true

# Neon/Vercel PostgreSQL (Vercel Neon integrations may expose either of these)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CORS_ORIGIN=https://certificateflow-portal.vercel.app

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=


SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME =
SMTP_PASSWORD=

# Free-plan storage protection
MAX_BULK_EMAILS=20
MAX_STORED_CERTIFICATE_FILES=50
MAX_STORED_CERTIFICATE_BYTES=104857600
MAX_EMAIL_LOGS=500
MAX_AUDIT_LOGS=1000
