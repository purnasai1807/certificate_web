# Production configuration (set real values in Render/Vercel, never commit secrets)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-in-production
ADMIN_FULL_NAME=Certificate Administrator
JWT_SECRET=generate-a-long-random-secret
REQUIRE_PERSISTENT_STORAGE=true
CORS_ORIGIN=https://certificateflow-portal.vercel.app

# Email provider: Brevo preferred


# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Free-plan storage protection
MAX_BULK_EMAILS=20
MAX_STORED_CERTIFICATE_FILES=50
MAX_STORED_CERTIFICATE_BYTES=104857600
MAX_EMAIL_LOGS=500
MAX_AUDIT_LOGS=1000
